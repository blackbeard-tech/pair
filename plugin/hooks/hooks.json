{
  "modules": ["./pane.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/scripts\"; ./pair hook session-start; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "inbox.jsonl",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/scripts\"; ./pair hook inbox; exit $LASTEXITCODE",
            "async": true,
            "asyncRewake": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
