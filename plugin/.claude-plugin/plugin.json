{
  "name": "pair",
  "version": "0.1.10",
  "description": "Pair your Claude Code session with a colleague's using a one-time code, then let the two agents message each other, end-to-end encrypted. Brought to you by Blackbeard Technologies.",
  "author": {
    "name": "Blackbeard Technologies",
    "url": "https://blackbeard.tech"
  },
  "homepage": "https://blackbeard.tech",
  "repository": "https://github.com/blackbeard-tech/pair",
  "license": "Apache-2.0",
  "keywords": [
    "pairing",
    "channels",
    "agents",
    "a2a",
    "magic-wormhole"
  ],
  "mcpServers": {
    "pair": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pair",
      "env": {
        "PAIR_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  },
  "channels": [
    {
      "server": "pair",
      "displayName": "pair"
    }
  ]
}
