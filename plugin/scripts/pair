#!/usr/bin/env bash
# Starts the pair channel server (stdout is the MCP transport: all messages go to stderr).
# First run fetches this version's release binary and verifies it against checksums.txt,
# which is pinned in the plugin commit you installed.
set -euo pipefail
REPO=blackbeard-tech/pair
root=$(cd "$(dirname "$0")/.." && pwd)
VERSION=$(sed -n 's/^# release v\([0-9][0-9.]*\).*/\1/p' "$root/checksums.txt")  # pinned release (CI keeps it equal to the plugin version)

# Monitors don't get CLAUDE_PLUGIN_DATA in their env, so `pair watch <data>` passes it as an argument.
if [ "${1:-}" = watch ] && [ -n "${2:-}" ]; then PAIR_DATA=$2; export PAIR_DATA; fi
# Hooks get the plugin data dir in their environment.
if [ -z "${PAIR_DATA:-}" ] && [ -n "${CLAUDE_PLUGIN_DATA:-}" ]; then PAIR_DATA=$CLAUDE_PLUGIN_DATA; export PAIR_DATA; fi
if [ -n "${PAIR_BIN:-}" ]; then exec "$PAIR_BIN" "$@"; fi  # dev override: a local build

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) asset=pair-macos-arm64 ;;
  Darwin-x86_64) asset=pair-macos-x64 ;;
  Linux-x86_64) asset=pair-linux-x64 ;;
  Linux-aarch64|Linux-arm64) asset=pair-linux-arm64 ;;
  MINGW*|MSYS*|CYGWIN*) asset=pair-windows-x64.exe ;;
  *) echo "pair: $(uname -s) $(uname -m) is not supported yet (macOS, Windows and Linux on x86_64/arm64 only)" >&2; exit 1 ;;
esac

dir="${PAIR_DATA:-$HOME/.cache/pair}/$VERSION"
bin="$dir/$asset"
if [ ! -x "$bin" ]; then
  want=$(awk -v a="$asset" '$2 == a { print $1 }' "$root/checksums.txt")
  [ -n "$want" ] || { echo "pair: no pinned checksum for $asset v$VERSION; update the plugin" >&2; exit 1; }
  mkdir -p "$dir"
  tmp="$bin.$$.part"  # per process: the monitor and the MCP server can both be downloading
  # gh first (host pinned: a gh logged in only to GitHub Enterprise would look there), then plain HTTPS.
  if ! { command -v gh >/dev/null && gh release download "v$VERSION" -R "github.com/$REPO" -p "$asset" -O "$tmp" --clobber >&2 2>&1; }; then
    curl -fsSL "https://github.com/$REPO/releases/download/v$VERSION/$asset" -o "$tmp" \
      || { rm -f "$tmp"; echo "pair: could not download $asset v$VERSION" >&2; exit 1; }
  fi
  got=$( (sha256sum "$tmp" 2>/dev/null || shasum -a 256 "$tmp") | cut -d' ' -f1)
  if [ "$got" != "$want" ]; then rm -f "$tmp"; echo "pair: checksum mismatch for $asset; refusing to run" >&2; exit 1; fi
  chmod +x "$tmp"
  # Atomic; if the other launcher got there first (and Windows locks the running exe), use its verified copy.
  mv -f "$tmp" "$bin" 2>/dev/null || rm -f "$tmp"
  [ -x "$bin" ] || { echo "pair: could not install $asset" >&2; exit 1; }
fi
exec "$bin" "$@"
